# Discovery Feed Service - Environment Configuration

# Server
SERVER_PORT=8080
ENV=development
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=feeduser
DB_PASSWORD=feedpass
DB_NAME=discoveryfeed
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10

# Kafka (optional)
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=feed-events
KAFKA_ENABLED=false

# AI Configuration
AI_ENABLED=true
AI_PROVIDER=mock
AI_API_KEY=
AI_ENDPOINT=
AI_MOCK_MODE=true

# Feature Flags
FEATURE_TRACING=true
FEATURE_AB_TESTING=true
FEATURE_PERSONALIZATION=true
FEATURE_KAFKA_EVENTS=false
